{
  "name": "video-to-audio-to-text",
  "version": "1.0.0",
  "description": "App desktop local para extrair audio de videos de reunioes (Fase 1 de um pipeline video -> audio -> texto).",
  "main": "dist/main/main.js",
  "author": "Pedro",
  "license": "MIT",
  "private": true,
  "scripts": {
    "clean": "rimraf dist release",
    "copy:assets": "copyfiles -u 1 \"src/renderer/**/*.{html,css}\" dist",
    "build:ts": "tsc -p tsconfig.json",
    "compile": "npm run build:ts && npm run copy:assets",
    "dev": "npm run compile && electron .",
    "start": "electron .",
    "build": "npm run clean && npm run compile && electron-builder --win",
    "build:dir": "npm run compile && electron-builder --win --dir"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^20.14.10",
    "copyfiles": "^2.4.1",
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3",
    "rimraf": "^5.0.9",
    "typescript": "^5.5.3"
  },
  "build": {
    "appId": "com.pedro.videotoaudio",
    "productName": "Video To Audio",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
